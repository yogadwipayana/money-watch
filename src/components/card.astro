---
import Link from "./link.astro";

const { broker, cash, invested, equity } = Astro.props;

const toSlug = (name: string) => name.toLowerCase();
---

<div class="bg-gray-700 w-full rounded-xl shadow-lg flex flex-col p-5 justify-center min-h-52">
  <div class="flex justify-between items-center mb-5">
    <h2 class="text-2xl font-bold text-white">{broker}</h2>
    <Link url={`/dashboard/${toSlug(broker)}`} Class="hover:scale-110 transition-transform" content="">
      <i class="fa-solid fa-arrow-right fa-lg text-white"></i>
    </Link>
  </div>
  
  <div class="mb-3">
    <p class="text-sm text-neutral-400 mb-1">Total Equity</p>
    <h1 class="text-3xl font-semibold text-white">{equity}</h1>
  </div>
  
  <div class="grid grid-cols-2 gap-4">
    <div>
      <p class="text-sm text-neutral-400 mb-1">Cash</p>
      <h3 class="text-lg font-medium text-white">{cash}</h3>
    </div>
    <div>
      <p class="text-sm text-neutral-400 mb-1">Invested</p>
      <h3 class="text-lg font-medium text-white">{invested}</h3>
    </div>
  </div>
</div>  
