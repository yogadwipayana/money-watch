---
const {
  variant = "default",
  size = "md",
  rounded = false,
  class: className = "",
} = Astro.props;

const variants = {
  default: "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300",
  success: "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300",
  danger: "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300",
  warning: "bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-300",
  info: "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300",
  buy: "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300",
  sell: "bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-300",
  deposit: "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300",
  withdrawal: "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300",
  BUY: "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300",
  SELL: "bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-300",
  DEPOSIT: "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300",
  WITHDRAWAL: "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300",
};

const sizes = {
  sm: "px-2 py-0.5 text-xs",
  md: "px-2.5 py-1 text-sm",
  lg: "px-3 py-1.5 text-base",
};

const roundedClass = rounded ? "rounded-full" : "rounded";
const baseClasses = "inline-flex items-center font-medium";
---

<span class:list={[baseClasses, variants[variant], sizes[size], roundedClass, className]}>
  <slot />
</span>
