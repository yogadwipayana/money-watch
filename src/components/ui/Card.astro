---
const {
  variant = "default",
  padding = "md",
  hover = false,
  clickable = false,
  class: className = "",
  ...props
} = Astro.props;

const variants = {
  default: "bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700",
  elevated: "bg-white dark:bg-gray-800 shadow-md",
  bordered: "bg-white dark:bg-gray-800 border-2 border-gray-300 dark:border-gray-600",
};

const paddings = {
  sm: "p-4",
  md: "p-6",
  lg: "p-8",
  none: "",
};

const hoverClass = hover ? "hover:-translate-y-0.5 hover:shadow-lg transition-all duration-200" : "";
const clickableClass = clickable ? "cursor-pointer" : "";

const baseClasses = "rounded-xl";
---

<div
  class:list={[baseClasses, variants[variant], paddings[padding], hoverClass, clickableClass, className]}
  {...props}
>
  <slot />
</div>
