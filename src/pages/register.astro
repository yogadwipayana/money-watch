---
import Layout from "../layouts/layout.astro";
import Navbar from "../layouts/navbar.astro";
import { setAuthToken, isAuthenticated } from "../utils/auth.js";

if (isAuthenticated(Astro.cookies)) {
  return Astro.redirect("/dashboard", 302);
}

let errorMessage = "";
let formName = "";
let formEmail = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const name = formData.get("name");
  const email = formData.get("email");
  const password = formData.get("password");

  formName = name?.toString() || "";
  formEmail = email?.toString() || "";

  if (!name || !email || !password) {
    errorMessage = "All fields are required";
  } else {
    try {
      const apiUrl = import.meta.env.API_URL;
      const response = await fetch(`${apiUrl}/register`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          name: name.toString(),
          email: email.toString(),
          password: password.toString(),
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        errorMessage = data.message || "Registration failed. Please try again.";
      } else {
        if (data.data?.token) {
          setAuthToken(Astro.cookies, data.data.token);
          return Astro.redirect("/dashboard", 302);
        } else {
          errorMessage = "Registration successful but no token received.";
        }
      }
    } catch (error) {
      console.error("Registration error:", error);
      errorMessage = "An error occurred. Please try again later.";
    }
  }
}
---

<Layout>
  <Navbar />
  <main class="mx-auto grid place-items-center min-h-screen px-4 py-8">
    <div class="w-full max-w-md bg-gray-700 p-6 rounded-xl sm:p-8">
      <h1 class="text-white text-xl font-semibold mb-2">Create your account</h1>
      <p class="text-neutral-400 text-sm mb-6">Enter the field below to create your account</p>
      
      {errorMessage && (
        <div class="bg-red-500/10 border border-red-500 text-red-500 text-sm p-3 rounded-lg mb-4">
          {errorMessage}
        </div>
      )}
      
      <form class="flex flex-col gap-4" method="POST">
        <div class="flex flex-col gap-2">
          <label for="name" class="text-white text-sm font-medium">Name</label>
          <input 
            class="bg-gray-600 px-4 py-3 rounded-lg text-white border border-gray-500 focus:outline-none focus:ring-2 focus:ring-neutral-400 transition-all" 
            type="text" 
            id="name" 
            name="name" 
            value={formName}
            placeholder="John Doe"
            required
          />
        </div>
        
        <div class="flex flex-col gap-2">
          <label for="email" class="text-white text-sm font-medium">Email</label>
          <input 
            class="bg-gray-600 px-4 py-3 rounded-lg text-white border border-gray-500 focus:outline-none focus:ring-2 focus:ring-neutral-400 transition-all" 
            type="email" 
            id="email" 
            name="email" 
            value={formEmail}
            placeholder="m@example.com"
            required
          />
        </div>
        
        <div class="flex flex-col gap-2">
          <label for="password" class="text-white text-sm font-medium">Password</label>
          <input 
            class="bg-gray-600 px-4 py-3 rounded-lg text-white border border-gray-500 focus:outline-none focus:ring-2 focus:ring-neutral-400 transition-all" 
            type="password" 
            id="password" 
            name="password"
            placeholder="Enter your password"
            required
          />
        </div>
        
        <button 
          class="bg-green-700 hover:bg-green-600 rounded-lg py-3 text-white font-medium transition-colors mt-2" 
          type="submit"
        >
          Register
        </button>
        
        <button 
          class="text-white bg-gray-600 hover:bg-gray-500 rounded-lg py-3 border border-gray-500 font-medium transition-colors" 
          type="button"
        >
          Register with Google
        </button>
        
        <p class="text-white text-center text-sm">
          Already have an account? 
          <a class="underline underline-offset-2 hover:text-neutral-300 transition-colors" href="/login">Login</a>
        </p>
      </form>
    </div>
  </main>
</Layout>