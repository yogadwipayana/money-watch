---
import Layout from "../layouts/layout.astro";
import Navbar from "../layouts/navbar.astro";
import BrokerCard from "../components/BrokerCard.astro";
import AddBrokerModal from "../components/AddBrokerModal.astro";
import Button from "../components/ui/Button.astro";
import { isAuthenticated } from "../utils/auth.js";
import { fetchBrokers, createBroker } from "../utils/api.js";

if (!isAuthenticated(Astro.cookies)) {
  return Astro.redirect("/login", 302);
}

let brokers = [];
let errorMessage = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const name = formData.get("name")?.toString()?.trim() || "";
    const balance = parseFloat(formData.get("balance")?.toString() || "0");

    if (!name || name.length < 2) {
      errorMessage = "Broker name must be at least 2 characters";
    } else if (!balance || balance <= 0) {
      errorMessage = "Cash balance must be greater than 0";
    } else {
      console.log("Sending broker data:", { name, balance });
      await createBroker({ name, balance }, Astro.cookies);
      return Astro.redirect("/dashboard", 303);
    }
  } catch (error) {
    console.error("Add broker error:", error);
    const addBrokerErrorMessage =
      error instanceof Error ? error.message : String(error ?? "Failed to add broker. Please try again.");
    errorMessage = addBrokerErrorMessage || "Failed to add broker. Please try again.";
  }
}

try {
  brokers = await fetchBrokers(Astro.cookies);
} catch (error) {
  console.error("Fetch brokers error:", error);
  errorMessage = "Failed to load brokers. Please try again later.";
}
---

<Layout title="Dashboard">
  <Navbar />
  
  <main class="min-h-screen bg-gray-50 dark:bg-gray-900 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Welcome Section -->
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">
          Welcome to Your Portfolio
        </h1>
        <p class="text-gray-600 dark:text-gray-400">
          Manage your stock brokers and track your investments
        </p>
      </div>

      <!-- Action Bar -->
      <div class="flex justify-between items-center mb-6">
        <div class="flex gap-3 flex-wrap">
          <Button variant="primary" onclick="openModal('addBrokerModal')">
            <i class="fa-solid fa-plus mr-2"></i>
            Add Broker
          </Button>
        </div>
      </div>

      {errorMessage && (
        <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200 px-4 py-3 rounded-lg mb-6">
          {errorMessage}
        </div>
      )}

      <!-- Broker Cards Grid -->
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {brokers.length > 0 ? (
          brokers.map((broker) => (
            <BrokerCard
              id={broker.id}
              broker={broker.name || 'Unnamed Broker'}
              cash={Number(broker.balance) || 0}
              invested={Number(broker.invested) || 0}
            />
          ))
        ) : (
          <div class="col-span-full">
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-12 text-center">
              <div class="w-16 h-16 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fa-solid fa-briefcase fa-2x text-gray-400 dark:text-gray-500"></i>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
                No Brokers Yet
              </h3>
              <p class="text-gray-600 dark:text-gray-400 mb-6">
                Get started by adding your first broker account
              </p>
              <Button variant="primary" onclick="openModal('addBrokerModal')">
                <i class="fa-solid fa-plus mr-2"></i>
                Add Your First Broker
              </Button>
            </div>
          </div>
        )}
      </div>
    </div>
  </main>

  <AddBrokerModal />
</Layout>
