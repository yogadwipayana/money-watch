---
import Link from "../components/link.astro";
import Logo from "../../public/favicon.svg";
import { isAuthenticated } from "../utils/auth.js";

const isLoggedIn = isAuthenticated(Astro.cookies);
---

<div class="relative z-10 w-full m-auto flex justify-center items-center bg-gray-800">
  <nav class="flex justify-between items-center py-3 px-4 w-full max-w-7xl">
    <div class="flex justify-center items-center gap-10">
      <a href="/" class="flex items-center">
        <Logo class="w-10 h-10" />
      </a>
      <div id="nav" class="nav-links duration-500 md:static absolute md:min-h-fit min-h-[30vh] left-0 top-[-195%] md:w-auto w-full flex place-content-center items-center text-center px-5 md:bg-transparent bg-gray-700">
        <ul class="flex md:flex-row flex-col md:items-center md:gap-8 gap-6">
          <li>
            <a href="/" class="text-white hover:text-blue-400 transition-colors text-base font-medium">
              Home
            </a>
          </li>
          {isLoggedIn && (
            <li>
              <a href="/dashboard" class="text-white hover:text-blue-400 transition-colors text-base font-medium">
                Dashboard
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>
    
    <div class="flex items-center gap-3">
      {isLoggedIn ? (
        <form action="/api/logout" method="POST" class="hidden md:block">
          <button
            type="submit"
            class="text-white bg-red-600 hover:bg-red-700 px-5 py-2 rounded-lg font-medium transition-colors"
          >
            <i class="fa-solid fa-right-from-bracket mr-2"></i>
            Logout
          </button>
        </form>
      ) : (
        <>
          <a
            href="/login"
            class="hidden md:block text-white hover:text-blue-400 px-5 py-2 rounded-lg font-medium transition-colors"
          >
            Login
          </a>
          <a
            href="/register"
            class="hidden md:block text-white bg-green-600 hover:bg-green-700 px-5 py-2 rounded-lg font-medium transition-colors"
          >
            Register
          </a>
        </>
      )}
      
      <button
        type="button"
        class="md:hidden text-white text-3xl"
        onclick="toggleMobileMenu()"
      >
        <i class="fa-solid fa-bars" id="menuIcon"></i>
      </button>
    </div>
  </nav>
</div>

<script is:inline>
  function toggleMobileMenu() {
    const nav = document.getElementById('nav');
    const icon = document.getElementById('menuIcon');
    
    if (nav) {
      nav.classList.toggle('top-[70px]');
      
      if (icon) {
        if (icon.classList.contains('fa-bars')) {
          icon.classList.remove('fa-bars');
          icon.classList.add('fa-xmark');
        } else {
          icon.classList.remove('fa-xmark');
          icon.classList.add('fa-bars');
        }
      }
    }
  }
</script>