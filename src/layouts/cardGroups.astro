---
---

<main class="flex flex-col items-center min-h-screen py-8">
  <div class="flex justify-end items-center w-full max-w-6xl px-4 mb-6">
    <button 
      id="addBrokerBtn" 
      class="bg-green-700 hover:bg-green-600 text-white px-6 py-3 rounded-lg font-medium transition-colors"
    >
      Add Broker
    </button>
  </div>
  
  <slot />

  <section 
    id="addBrokerModal" 
    class="hidden fixed inset-0 bg-black/80 items-center justify-center z-50 px-4"
  >
    <div class="bg-gray-700 rounded-lg w-full max-w-md p-6 sm:p-8">
      <h1 class="text-white text-xl font-semibold mb-6">Add Broker</h1>
      
      <form class="flex flex-col gap-4" action="/dashboard" method="POST">
        <div class="flex flex-col gap-2">
          <label for="broker" class="text-white text-sm font-medium">Broker Name</label>
          <input 
            class="bg-gray-200 px-4 py-3 rounded-lg text-black border border-gray-500 focus:outline-none focus:ring-2 focus:ring-neutral-400 transition-all" 
            type="text" 
            id="broker" 
            name="broker" 
            required 
            placeholder="Stockbit"
          />
        </div>
        
        <div class="flex flex-col gap-2">
          <label for="cash" class="text-white text-sm font-medium">Cash Balance</label>
          <input 
            class="bg-gray-200 px-4 py-3 rounded-lg text-black border border-gray-500 focus:outline-none focus:ring-2 focus:ring-neutral-400 transition-all" 
            type="number" 
            id="cash" 
            name="cash" 
            required 
            placeholder="1000000"
          />
        </div>
        
        <div class="grid grid-cols-2 gap-4 mt-2">
          <button 
            id="cancelBtn" 
            class="bg-neutral-400 hover:bg-neutral-500 rounded-lg py-3 text-white font-medium transition-colors" 
            type="button"
          >
            Cancel
          </button>
          <button 
            class="bg-green-700 hover:bg-green-600 rounded-lg py-3 text-white font-medium transition-colors" 
            type="submit"
          >
            Add Broker
          </button>
        </div>
      </form>
    </div>
  </section>
</main>

<script>
  const openModal = () => {
    const modal = document.getElementById('addBrokerModal');
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  };

  const closeModal = () => {
    const modal = document.getElementById('addBrokerModal');
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    const addBtn = document.getElementById('addBrokerBtn');
    const cancelBtn = document.getElementById('cancelBtn');
    
    addBtn?.addEventListener('click', openModal);
    cancelBtn?.addEventListener('click', closeModal);
  });
</script>